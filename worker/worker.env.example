# 知途（Campus Pathway）worker 部署配置模板
# 复制到 /etc/campus-pathway/worker.env 并填入真实值；本文件不得包含真实密钥。
# 权限：chmod 600 /etc/campus-pathway/worker.env，仅 worker 用户可读。

# --- Supabase（service/secret key 只出现在 worker 服务端，绝不下发浏览器）---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=4096
EMBEDDING_NORMALIZATION=l2
EMBEDDING_QUERY_TEMPLATE_VERSION=career-qwen-v1
# 探针确认提供方不会自动加 instruction 时保持 explicit_template；
# 若确认提供方自动加 instruction，改成 provider_auto（避免重复 instruction）。
EMBEDDING_INSTRUCTION_MODE=explicit_template
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat

# --- worker 运行参数 ---
WORKER_CONCURRENCY=1
RUN_MAX_ATTEMPTS=3
MODEL_REQUEST_TIMEOUT_SECONDS=60
# 必填：留空时 worker 拒绝调用模型（fail closed，不解释为无限预算）。
MODEL_MONTHLY_BUDGET_USD=
# 可选：每百万 token 价格（USD），用于 app_usage.estimated_cost 与预算预估；
# 不填时仍记录 token，成本写 NULL，不伪造价格。
# MODEL_INPUT_PRICE_USD_PER_MTOK=
# MODEL_OUTPUT_PRICE_USD_PER_MTOK=
# EMBEDDING_PRICE_USD_PER_MTOK=
# 未知成本的历史用量按每条预留多少美元计入预算（避免把未知当 0）。
UNKNOWN_USAGE_RESERVE_USD=0.02

# --- 可选调参（有保守默认值；修改 gate 阈值必须同时升级 RETRIEVAL_GATE_VERSION）---
# WORKER_ID=
# WORKER_POLL_INTERVAL_SECONDS=5
# WORKER_HEARTBEAT_SECONDS=30
# WORKER_LEASE_SECONDS=120
# WORKER_LOG_LEVEL=INFO
# RETRIEVAL_CANDIDATE_LIMIT=64
# RETRIEVAL_MIN_EVIDENCE=8
# RETRIEVAL_MAX_EVIDENCE=12
# RETRIEVAL_MAX_PER_DOCUMENT=3
# RETRIEVAL_MAX_PER_SOURCE=4
# RETRIEVAL_CHAR_BUDGET=7000
# RETRIEVAL_NEIGHBOR_EXPANSION=true
# GATE_DENSE_MIN_SIMILARITY=0.60
# GATE_LEXICAL_MIN_SCORE=0.08
# GATE_KEYWORD_OVERLAP_MIN=3
# RETRIEVAL_GATE_VERSION=career-gate-2026-10-19.1
# CHUNK_TARGET_TOKENS=600
# CHUNK_OVERLAP_TOKENS=80
# CHUNK_MIN_CHARS=40
# CHUNK_MAX_TABLE_TOKENS=1200
# INGEST_MAX_CHUNKS=4000
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_PROFILE_ID=career-qwen3-embedding-8b-4096-career-qwen-v1
# CHAT_JSON_MODE=auto
# OPENROUTER_CHAT_TEMPERATURE=0.1
# OPENROUTER_CHAT_MAX_TOKENS=1600
# CAREER_RULES_VERSION=career-rules-2026-10-19.1
# CAREER_PROMPT_VERSION=career-prompts-2026-10-19.1
# DOCLING_ENABLED=true
