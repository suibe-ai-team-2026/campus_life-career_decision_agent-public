# 知途（Campus Pathway）配置模板，不含任何真实密钥。
# 真实值只放本地 .env.local 或部署平台环境变量；不要把整份文件上传到任何平台。
# 权限与部署规则见 docs/architecture/security.md 与 docs/deployment.md。

# --- Next.js / Vercel：前端可公开配置 ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Vercel BFF 服务端：Supabase 用户态不需要 secret；仅上传签发/清理需要 ---
# 新式 secret key 或 legacy service_role；只放服务端环境变量，禁止 NEXT_PUBLIC_ 前缀。
SUPABASE_SECRET_KEY=

# --- 仅受信任 Freestyle worker：服务端运行配置 ---
SUPABASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=4096
EMBEDDING_NORMALIZATION=l2
EMBEDDING_QUERY_TEMPLATE_VERSION=career-qwen-v1
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
WORKER_CONCURRENCY=1
RUN_MAX_ATTEMPTS=3
MODEL_REQUEST_TIMEOUT_SECONDS=60
# 按用户实际预算填写；空值不能解释为无限预算。
MODEL_MONTHLY_BUDGET_USD=

# --- 仅运维 / CI：不传浏览器、不传文档解析器 ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
VERCEL_TOKEN=
FREESTYLE_API_KEY=

# --- 资源选择，供部署脚本读取；不是登录凭据 ---
GITHUB_REPOSITORY=suibe-ai-team-2026/campus_life-career_decision_agent
SUPABASE_MODE=new_project_or_authorized_reuse
SUPABASE_ORG_ID=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=
VERCEL_SCOPE=
VERCEL_PROJECT_NAME=campus-pathway-career
FREESTYLE_TEAM=
