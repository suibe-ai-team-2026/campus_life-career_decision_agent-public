{
  "name": "campus-pathway-career",
  "version": "0.1.0",
  "private": true,
  "description": "知途（Campus Pathway）· 纯生涯规划版本：Next.js/Vercel BFF + Supabase + Freestyle worker",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "worker:test": "cd worker && uv run pytest -q",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:dry-run": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "import:dry-run": "tsx scripts/import-research.ts --dry-run",
    "import:apply": "tsx scripts/import-research.ts --apply",
    "probe:models": "tsx scripts/probe-models.ts",
    "probe:embedding": "tsx scripts/probe-embedding.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "freestyle": "0.2.20",
    "supabase": "2.121.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vercel": "64.5.0",
    "vitest": "4.0.18",
    "@eslint/eslintrc": "3.3.3"
  }
}
